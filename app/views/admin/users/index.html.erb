<h1>Manage Users</h1>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr><th>Email</th><th>Name</th><th>Role</th><th></th><th></th></tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email_address %></td>
          <td><%= user.name %></td>
          <td>
            <%= form_with url: admin_user_path(user), method: :patch do |form| %>
              <%= form.select :role, User.roles.keys, { selected: user.role }, name: "user[role]", class: "form-select form-select-sm", onchange: "this.form.requestSubmit()" %>
            <% end %>
          </td>
          <td>
            <% unless user == Current.user %>
              <%= button_to "Delete", admin_user_path(user), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
