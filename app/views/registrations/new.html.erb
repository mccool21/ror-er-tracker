<h1>Sign up</h1>

<%= tag.div(@user.errors.full_messages.to_sentence, class: "alert alert-danger") if @user.errors.any? %>

<%= form_with model: @user, url: registrations_path do |form| %>
  <div class="mb-3">
    <%= form.label :email_address, "Email address", class: "form-label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, placeholder: "Email address", class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :name, "Name (optional)", class: "form-label" %>
    <%= form.text_field :name, placeholder: "Name (optional)", class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :password, class: "form-label" %>
    <%= form.password_field :password, required: true, placeholder: "Password", maxlength: 72, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
    <%= form.password_field :password_confirmation, required: true, placeholder: "Confirm password", maxlength: 72, class: "form-control" %>
  </div>
  <%= form.submit "Sign up", class: "btn btn-primary" %>
<% end %>

<%= button_to "Sign up with Google", "/auth/google_oauth2", data: { turbo: false }, method: :post, class: "btn btn-outline-secondary mt-3" %>

<p class="mt-3"><%= link_to "Already have an account? Sign in", new_session_path %></p>
